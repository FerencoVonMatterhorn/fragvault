# Serves the built SPA and nothing else. Routing /api and /auth to the
# backend is Caddy's job (deploy/Caddyfile) — this container never sees those
# requests. It used to proxy them itself, which meant two places defining the
# same routing, free to drift apart.
#
# Still a template rather than a plain .conf so the image keeps working with
# the stock entrypoint; there is simply nothing to substitute right now.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The SPA payload is text; not compressing it wastes most of the transfer.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Above the SPA fallback on purpose: `location /` would otherwise answer
    # this with index.html and the healthcheck would pass on a broken app.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Vite fingerprints these filenames, so a given name's content can never
    # change — cache them hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # The entry point must never be cached, or browsers keep loading the old
    # build's asset references after a deploy.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Client-side routing: any unknown path is a route, not a missing file.
    # Without this a refresh on a deep link 404s.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
