# Copy to .env on the VM, fill in, and chmod 600. The real file is
# gitignored and must never be committed — it holds live credentials.
#
#   cp .env.example .env && chmod 600 .env

# https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

# Signs session cookies. Generate with:  openssl rand -hex 32
# Changing it logs everyone out, which is also how you revoke every session.
SESSION_SECRET=

# Must match the public URL exactly. Steam OpenID redirects back to this
# address, and the session cookie is marked Secure, so it has to be https —
# over plain http the browser silently drops the cookie and login appears to
# do nothing.
BASE_URL=https://fragvault.pro

# Postgres. Used by both the database container and the backend's
# DATABASE_URL, which compose builds from it. Generate with:
#   openssl rand -hex 24
# Changing it after the volume exists does NOT change the database's own
# password — Postgres only reads it when it first initialises the volume.
POSTGRES_PASSWORD=

# --- Game coordinator sidecar -------------------------------------------
# Resolves sharecodes to demo URLs. Use a DEDICATED, DISPOSABLE Steam
# account that owns CS2 and nothing worth stealing — never your own. These
# credentials sit on the VM, and the sidecar's dependency tree has known
# CVEs it cannot escape (see gc-sidecar/README.md).
STEAM_ACCOUNT_NAME=
STEAM_PASSWORD=

# TOTP shared secret from the mobile authenticator. Optional, but without it
# a restart can require a human to answer Steam Guard.
STEAM_SHARED_SECRET=
