# Copy to .env (which is gitignored) and fill in. Read by docker-compose.yml.

# https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

# Any random string, 32+ characters. Rotating it invalidates every session.
#   openssl rand -hex 32
SESSION_SECRET=

# The address you open in the browser. Steam redirects back here after login,
# so it has to match what you actually type, port included.
BASE_URL=http://localhost:8080

# Port published on the host. Change if 8080 is taken; keep BASE_URL in step.
HOST_PORT=8080

# Session cookies are Secure by default and a browser won't send those back
# over plain http. Leave true for local compose, false behind TLS.
DEV_INSECURE_COOKIE=true
