# Shell scripts must keep LF endings — CRLF breaks them on Linux and in Azure
# Cloud Shell ("\r: command not found"), and this repo is edited on Windows.
*.sh text eol=lf

# Same reasoning for anything CI or a Linux host executes verbatim.
*.yml text eol=lf
*.yaml text eol=lf

# Terraform runs on Windows locally and Linux in CI; pin these so the lock
# file and configs don't churn line endings between the two.
*.tf text eol=lf
*.hcl text eol=lf

# The GPU VM's bootstrap script is embedded into the CustomScriptExtension's
# settings by `file()`, so its exact bytes are part of the plan. A CRLF
# checkout on Windows and an LF one in CI would hash differently and re-run the
# bootstrap on every apply. PowerShell is happy with LF.
*.ps1 text eol=lf

# Container build inputs are consumed by Linux tooling only.
Dockerfile text eol=lf
.dockerignore text eol=lf
*.template text eol=lf
Caddyfile text eol=lf
.env.example text eol=lf

# gofmt treats CRLF as unformatted, so a Windows checkout fails `gofmt -l`
# locally even though CI (which checks out LF) is perfectly happy. Pinning
# these makes the local check mean the same thing as the CI one.
*.go text eol=lf
*.sql text eol=lf
