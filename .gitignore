# Go
backend/fragvault-data.json
backend/*.tmp

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
# `tsc -b` incremental build state — machine-local, regenerated every build.
frontend/*.tsbuildinfo

# Terraform
infrastructure/.terraform/
infrastructure/*.tfstate
infrastructure/*.tfstate.*
infrastructure/*.tfplan
infrastructure/*.tfvars
!infrastructure/*.tfvars.example
# terraform.tfvars is the exception and is committed: it holds this single
# environment's non-secret values (region, VM sizes, names) so they're readable
# in a diff instead of buried in repository settings. The blanket rule above
# still catches anything else — if you ever need a local override, put it in a
# differently-named .tfvars and it stays ignored. Nothing secret goes in either:
# this repo is public.
!infrastructure/terraform.tfvars
infrastructure/.terraform.lock.hcl.backup

# Deployment
# Live credentials (Steam API key, session secret). Only ever created on the
# VM; deploy/.env.example is the committed template.
deploy/.env

# Local agent tooling: launch configs and session state, machine-specific and
# of no use to anyone cloning this.
.claude/

# Editors / OS
.DS_Store
*.swp
.vscode/
.idea/
