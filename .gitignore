# Go
backend/fragvault-data.json
backend/*.tmp

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
# `tsc -b` incremental build state — machine-local, regenerated every build.
frontend/*.tsbuildinfo

# Terraform
infrastructure/.terraform/
infrastructure/*.tfstate
infrastructure/*.tfstate.*
infrastructure/*.tfplan
infrastructure/*.tfvars
!infrastructure/*.tfvars.example
infrastructure/.terraform.lock.hcl.backup

# Deployment
# Live credentials (Steam API key, session secret). Only ever created on the
# VM; deploy/.env.example is the committed template.
deploy/.env

# Local agent tooling: launch configs and session state, machine-specific and
# of no use to anyone cloning this.
.claude/

# Editors / OS
.DS_Store
*.swp
.vscode/
.idea/
